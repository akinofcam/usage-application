{
  "name": "usage",
  "version": "1.8.5",
  "description": "macOS app usage tracker with folder protection",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --development",
    "build": "electron-builder",
    "package": "electron-builder --mac",
    "build-dmg": "node scripts/build-dmg.js",
    "generate-logo": "node scripts/generate-logo.js",
    "verify": "bash verify.sh",
    "lint": "eslint src/",
    "lint-fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,json,html}\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "bin": {
    "usage": "./src/cli.js"
  },
  "keywords": [
    "macos",
    "app-tracker",
    "productivity",
    "usage",
    "electron",
    "security",
    "protection"
  ],
  "author": "Akinchit Sahoo <akinoffcam@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/akinofcam/usage-application",
  "repository": {
    "type": "git",
    "url": "https://github.com/akinofcam/usage-application"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "sqlite3": "^5.1.6",
    "yargs": "^17.7.2"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11",
    "mac-biometric-authenticate": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.usage.app",
    "productName": "Usage",
    "icon": "assets/logo-512x512.png",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "11.0.0",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Productivity",
      "icon": "assets/logo-512x512.png"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
